{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": null,
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/v1/:path*",
            "destination": "https://app.maitreyabeachresort.in/v1/:path*"
        },
        {
            "source": "/((?!assets/|robots\\.txt|placeholder\\.svg).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}